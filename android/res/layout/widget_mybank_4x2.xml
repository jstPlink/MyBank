<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 4x2: in alto la striscia del mese (il numero dei giorni rimanenti con «giorni rimanenti» su due righe, e i giorni del mese su una riga con una tacca e il numero ogni sette giorni, weekend in rosso), sotto tre celle di
     uguale larghezza (Spesa, Svago, Auto; niente Altro) con il livello del residuo che riempie la cella dal basso, nome e residuo su una targhetta
     scura, stima e reale in due etichette piene.
     Solo view ammesse nei RemoteViews (vedi test/android.test.js): un solo carattere, sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">
    <FrameLayout
        android:id="@+id/widget_month_cell"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_month_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="7dp"
            android:paddingRight="7dp">
                        <TextView
                android:id="@+id/widget_days_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="24sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_days_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:textColor="#A8A298"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lines="2" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/widget_weeks"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:orientation="horizontal"
                    android:weightSum="33">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:text="1"
                        android:textColor="#A8A298"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:text="8"
                        android:textColor="#A8A298"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:text="15"
                        android:textColor="#A8A298"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="7"
                        android:text="22"
                        android:textColor="#A8A298"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                    <TextView
                        android:id="@+id/widget_day_label_29"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="5"
                        android:text="29"
                        android:textColor="#A8A298"
                        android:textSize="9sp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
    <FrameLayout
        android:id="@+id/widget_spesa_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_spesa_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_spesa_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPESA"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_spesa_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_spesa_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_svago_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_svago_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_svago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVAGO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_svago_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_svago_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_carburante_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_carburante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_carburante_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_carburante_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
