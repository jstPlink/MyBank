<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 5x1, cinque celle di uguale larghezza (Mese, Spesa, Svago, Auto, Altro). In ogni categoria, a sinistra, una barra a due blocchi
     separati da uno spazio: in alto la parte vuota (grigio scuro), in basso il livello del residuo (chiaro, rosso sotto il 25%); a destra il nome,
     il residuo e, in basso, stima e reale. Il mese: giorni che restano e le settimane del calendario (weekend in rosso).
     Solo view ammesse nei RemoteViews (vedi test/android.test.js): un solo carattere, sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">
    <FrameLayout
        android:id="@+id/widget_month_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_month_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MESE"
                android:textColor="@color/w_mute"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                android:id="@+id/widget_days_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_days_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textColor="@color/w_mute"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/widget_weeks"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:scaleType="fitXY" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_spesa_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_spesa_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/widget_spesa_bar"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="21dp"
            android:paddingRight="3dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_spesa_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPESA"
                android:textColor="@color/w_mute"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/w_ink"
                android:textSize="15sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="left"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_spesa_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_svago_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_svago_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/widget_svago_bar"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="21dp"
            android:paddingRight="3dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_svago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVAGO"
                android:textColor="@color/w_mute"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/w_late"
                android:textSize="15sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="left"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_svago_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_late"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_carburante_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/widget_carburante_bar"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="21dp"
            android:paddingRight="3dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_carburante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="@color/w_mute"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/w_ink"
                android:textSize="15sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="left"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_carburante_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_altro_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_altro_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <ImageView
            android:id="@+id/widget_altro_bar"
            android:layout_width="12dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingLeft="21dp"
            android:paddingRight="3dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:id="@+id/widget_altro_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTRO"
                android:textColor="@color/w_mute"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_altro_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/w_ink"
                android:textSize="15sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeMaxTextSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="left"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_altro_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_altro_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/w_ink"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
