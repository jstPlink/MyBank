<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 4x2: in alto la striscia del mese (giorni rimanenti e giorni del mese su una sola riga, weekend in rosso), sotto tre celle di
     uguale larghezza (Spesa, Svago, Auto; niente Altro) con il livello del residuo che riempie la cella dal basso, nome e residuo su una targhetta
     scura, stima e reale in due etichette piene. Anteprima statica per la lista dei widget.
     Solo view ammesse nei RemoteViews (vedi test/android.test.js): un solo carattere, sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="2.25dp">
        <ImageView
            android:src="@drawable/preview_month"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="7dp"
            android:paddingRight="7dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MESE"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:textColor="#F3F0EA"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="13" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:textColor="#A8A298"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="giorni rimanenti" />
            <ImageView
                android:src="@drawable/preview_days"
                android:layout_width="0dp"
                android:layout_height="7dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:scaleType="fitXY" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:src="@drawable/preview_spesa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_spesa_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPESA"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true"
                android:text="186 €" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="stima 9,0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="reale 7,1" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:src="@drawable/preview_svago"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_svago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVAGO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true"
                android:text="24 €" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="stima 5,0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="reale 7,3" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:src="@drawable/preview_carburante"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_carburante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true"
                android:text="112 €" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="stima 4,0" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:text="reale 3,2" />
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>
</LinearLayout>
